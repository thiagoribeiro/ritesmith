# RiteSmith environment configuration
# Copy this file to .env and fill in the values for your deployment.
# Never commit .env — it is gitignored.

# ── Database ───────────────────────────────────────────────────────────────
RITESMITH_DATABASE_URL=postgresql+asyncpg://ritesmith:yourpassword@localhost:5432/ritesmith

# ── LLM ────────────────────────────────────────────────────────────────────
RITESMITH_OPENAI_API_KEY=sk-...
RITESMITH_LLM_MODEL=gpt-4.1
RITESMITH_LLM_MODEL_FAST=gpt-4o-mini

# ── Policy ─────────────────────────────────────────────────────────────────
# One of: allow | deny | require_approval
RITESMITH_POLICY_DEFAULT=deny
RITESMITH_ALLOW_UNAPPROVED_LOW_RISK=true

# ── Networking ─────────────────────────────────────────────────────────────
RITESMITH_HTTP_PORT=8081
# Public URL used in callback payloads
RITESMITH_PUBLIC_URL=http://ritesmith:8081

# ── Workflow delegation (Trama) ─────────────────────────────────────────────
RITESMITH_WORKFLOW_DELEGATION_ENABLED=false
# RITESMITH_WORKFLOW_ENGINE_URL=http://trama:8080
# RITESMITH_TRAMA_TOKEN=changeme

# ── Volumes / filesystem ────────────────────────────────────────────────────
# Override these in docker-compose via env vars:
#   RITESMITH_REPORTS_PATH=/absolute/path/to/reports
#   RITESMITH_FINDTAG_PATH=/absolute/path/to/findtag
RITESMITH_REPORTS_PATH=

# ── Integrations (all optional) ─────────────────────────────────────────────
# Telegram
# RITESMITH_TELEGRAM_BOT_TOKEN=
# RITESMITH_TELEGRAM_CHAT_ID=

# Web search (Brave)
# RITESMITH_WEB_SEARCH_API_KEY=

# Exa
# RITESMITH_EXA_API_KEY=

# Google (Calendar / Gmail) — path to token.json and client_secrets.json
# RITESMITH_GOOGLE_TOKEN_JSON=/path/to/token.json
# RITESMITH_GOOGLE_CLIENT_SECRETS_JSON=/path/to/client_secrets.json
# RITESMITH_GOOGLE_CALENDAR_IDS=personal:primary

# DuckDB
# RITESMITH_DUCKDB_PATH=/path/to/data.duckdb
# RITESMITH_DUCKDB_ALLOWED_PATHS=/path/to/allowed

# Obsidian vault
# RITESMITH_OBSIDIAN_VAULT_PATH=/path/to/vault

# Grafana + Prometheus
# RITESMITH_GRAFANA_URL=http://grafana:3000
# RITESMITH_GRAFANA_TOKEN=
# RITESMITH_PROMETHEUS_URL=http://prometheus:9090

# LoomHarbor (legacy CASP provider)
# RITESMITH_LOOMHARBOR_URL=http://loomharbor:8000
# RITESMITH_LOOMHARBOR_SECRET=

# CASP providers (JSON array — overrides individual loomharbor_* fields)
# RITESMITH_CASP_PROVIDERS=[{"url":"http://loomharbor:8000"}]
