# Overlay only on an isolated instance. This does not qualify production latency/cost.
RITESMITH_LLM_SCRIPT_MODEL=gpt-5-mini
RITESMITH_LLM_WORKFLOW_MODEL=gpt-5.4-mini
RITESMITH_LLM_REASONING_EFFORT=low
RITESMITH_LLM_SCRIPT_EFFORT=low
RITESMITH_LLM_WORKFLOW_EFFORT=low
RITESMITH_GENERATION_TYPED_PROMPTS=true
RITESMITH_GENERATION_LUAU_ASSEMBLY=true
RITESMITH_GENERATION_SEMANTIC_WORKFLOWS=true
RITESMITH_GENERATION_COMPACT_WORKFLOWS=true
RITESMITH_GENERATION_MERMAID_WORKFLOWS=false
RITESMITH_GENERATION_BOUNDED_RECOVERY=true
RITESMITH_GENERATION_MAX_ATTEMPTS=2
RITESMITH_GENERATION_RECOVERY_ATTEMPTS=1
RITESMITH_GENERATION_RECOVERY_MIN_SECONDS=3
RITESMITH_GENERATION_LATENCY_TARGET_SECONDS=10
RITESMITH_GENERATION_DEADLINE_SECONDS=30

# Do not accept a lower certification tier to satisfy the time target.
RITESMITH_REQUIRE_STRICT_TYPECHECK=true
