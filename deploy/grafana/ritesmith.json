{
  "title": "RiteSmith",
  "uid": "ritesmith",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["ritesmith"],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [

    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Rate (req/s)",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_http_requests_total[1m])) by (method, endpoint)",
          "legendFormat": "{{method}} {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request Latency p50/p95/p99",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ritesmith_http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ritesmith_http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p95 {{endpoint}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ritesmith_http_request_duration_seconds_bucket[1m])) by (le, endpoint))",
          "legendFormat": "p99 {{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error Rate (5xx)",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_http_requests_total{status_code=~'5..'}[5m]))",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total Requests (last 1h)",
      "gridPos": { "x": 16, "y": 5, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "increase(ritesmith_http_requests_total[1h])",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 10,
      "type": "row",
      "title": "LLM",
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LLM Call Duration p50/p95",
      "gridPos": { "x": 0, "y": 10, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ritesmith_llm_request_duration_seconds_bucket[5m])) by (le, method))",
          "legendFormat": "p50 {{method}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ritesmith_llm_request_duration_seconds_bucket[5m])) by (le, method))",
          "legendFormat": "p95 {{method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "LLM Tokens/min",
      "gridPos": { "x": 8, "y": 10, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_llm_tokens_total[1m])) by (token_type)",
          "legendFormat": "{{token_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "LLM Errors/min",
      "gridPos": { "x": 16, "y": 10, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_llm_errors_total[1m])) by (error_type)",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Generation",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Generation Attempts / Outcome",
      "gridPos": { "x": 0, "y": 19, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_generation_attempts_total[5m])) by (artifact_type, outcome)",
          "legendFormat": "{{artifact_type}} {{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Artifact Reuse Rate",
      "gridPos": { "x": 8, "y": 19, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_artifact_reuse_total[5m])) by (artifact_type)",
          "legendFormat": "{{artifact_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Validation Failures / Check",
      "gridPos": { "x": 16, "y": 19, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_validation_failures_total[5m])) by (artifact_type, check_name)",
          "legendFormat": "{{artifact_type}} / {{check_name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Execution",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Execution Duration p50/p95",
      "gridPos": { "x": 0, "y": 28, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ritesmith_execution_duration_seconds_bucket[5m])) by (le, runtime))",
          "legendFormat": "p50 {{runtime}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ritesmith_execution_duration_seconds_bucket[5m])) by (le, runtime))",
          "legendFormat": "p95 {{runtime}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Execution Status / min",
      "gridPos": { "x": 8, "y": 28, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_execution_status_total[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 33,
      "type": "stat",
      "title": "Lua Timeouts",
      "gridPos": { "x": 16, "y": 28, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "increase(ritesmith_lua_timeout_total[1h])",
          "legendFormat": "timeouts/1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Sandbox & FTS",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Sandbox Queue Depth",
      "gridPos": { "x": 0, "y": 37, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "ritesmith_sandbox_queue_depth",
          "legendFormat": "queue depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 7 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "area" } }
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "FTS Search Duration p95",
      "gridPos": { "x": 8, "y": 37, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ritesmith_fts_search_duration_seconds_bucket[5m])) by (le, artifact_type))",
          "legendFormat": "p95 {{artifact_type}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "FTS Result Count Distribution",
      "gridPos": { "x": 16, "y": 37, "w": 8, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(ritesmith_fts_search_result_count_bucket[5m])) by (le))",
          "legendFormat": "p50 results"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ritesmith_fts_search_result_count_bucket[5m])) by (le))",
          "legendFormat": "p95 results"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },

    {
      "id": 50,
      "type": "row",
      "title": "Policy",
      "gridPos": { "x": 0, "y": 45, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Policy Decisions / min",
      "gridPos": { "x": 0, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ritesmith_policy_decisions_total[1m])) by (decision)",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 52,
      "type": "timeseries",
      "title": "Lua↔Python Conversion Depth",
      "gridPos": { "x": 12, "y": 46, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ritesmith_sandbox_conversion_depth_bucket[5m])) by (le))",
          "legendFormat": "p99 depth"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ritesmith_sandbox_conversion_depth_bucket[5m])) by (le))",
          "legendFormat": "p50 depth"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }

  ]
}
