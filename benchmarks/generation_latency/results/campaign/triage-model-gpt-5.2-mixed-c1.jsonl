ror = list_r.error, message = list_r.message }\n    end\n\n    local candidates: { CustomerRef } = list_r.customers or {}\n    local notified: { string } = {}\n    local failed: { string } = {}\n\n    -- iterate customers in list order, send at most 10 messages\n    local sends_left: number = 10\n    for i, cust in candidates do\n        if sends_left <= 0 then\n            break\n        end\n        if cust.last_seen_days >= input.inactive_days then\n            local name = cust.name or \"\"\n            local text = \"Hi \" .. name .. \", we miss you!\"\n            -- interpolation performed via concatenation\n            local send_r = tools.message.send({ user = cust.id, text = text })\n            if not send_r.ok then\n                table.insert(failed, cust.id)\n            else\n                table.insert(notified, cust.id)\n            end\n            sends_left -= 1\n        end\n    end\n\n    return { notified = notified, failed = failed, count = #notified }\nend", "content_hash": "054ede3a32c22ebc77d801d7cbe9a5e9a13b53dc23e3d8b7443546a994d9928e", "description": "List customers in a segment and message inactive ones up to 10 sends", "usage_description": null, "generated_by_plan_id": null, "source_artifact_ids": null, "tags": ["crm", "messaging"], "risk_level": "low", "validation": null, "created_at": "2026-10-08T02:08:26.081106Z", "updated_at": "2026-10-08T02:08:26.081106Z", "metadata": {"runtime_profile": "transform_only", "certification": "strict"}}, "validation": {"valid": true, "risk_level": null, "checks": [{"name": "strict_type_check", "status": "passed", "message": null}, {"name": "forbidden_tokens", "status": "passed", "message": null}, {"name": "size_limit", "status": "passed", "message": null}, {"name": "run_function", "status": "passed", "message": null}], "warnings": [], "errors": []}, "reused": false, "source_artifact_id": null}}
