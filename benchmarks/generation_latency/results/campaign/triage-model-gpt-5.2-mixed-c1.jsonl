{"task": "t1_percent_change", "kind": "luau_script", "held_out": false, "phase": "model", "model": "gpt-5.2", "repetition": 1, "provider_cache_mode": "normal", "client_tests": true, "entrypoint": "specialized", "concurrency": 1, "duration_s": 10.601871669990942, "http_status": 200, "valid": true, "errors": [], "calls": [{"method": "luau_gen", "model": "gpt-5.2", "duration_s": 3.6130503729800694, "api_attempts": 3, "error": "LLMRateLimitError"}, {"model": "gpt-5-mini", "resolved_model": "gpt-5-mini-2025-08-07", "reasoning_effort": "low", "prompt_tokens": 1154, "completion_tokens": 609, "total_tokens": 1763, "duration_s": 4.821567144012079, "reasoning_tokens": 256, "cached_tokens": 1024, "api_attempts": 1, "method": "luau_gen", "fallback": true, "examples": []}], "stages": [{"stage": "recall", "artifact_type": "luau_script", "duration_s": 0.017115661001298577}, {"stage": "validation", "artifact_type": "luau_script", "duration_s": 0.06520519295008853}, {"stage": "persist", "artifact_type": "luau_script", "duration_s": 0.004398946010041982}], "response": {"artifact": {"artifact_id": "art_01M4CM9QCP9VB3E0R69906SH8T", "artifact_type": "luau_script", "name": "percentage_change_direction", "version": 1, "status": "draft", "content": "function run(input: Input, context: Context): Output\n    -- Validate initial value\n    if input.initial_value == 0 then\n        return { error = \"invalid_initial_value\", message = \"initial_value must not be zero\" }\n    end\n\n    local function round2(n: number): number\n        -- Round to 2 decimal places, handling negative numbers correctly\n        if n >= 0 then\n            return math.floor(n * 100 + 0.5) / 100\n        else\n            return math.ceil(n * 100 - 0.5) / 100\n        end\n    end\n\n    local initial: number = input.initial_value\n    local current: number = input.current_value\n\n    local raw_change: number = ((current - initial) / initial) * 100\n    local pct: number = round2(raw_change)\n\n    local direction: string\n    if current > initial then\n        direction = \"up\"\n    elseif current < initial then\n        direction = \"down\"\n    else\n        direction = \"flat\"\n    end\n\n    return { percentage_change = pct, direction = direction }\nend", "content_hash": "3224a7ff98fbac4fbe016abf03eece11353839d7542ccff04edfae8d275b80d5", "description": "Compute percent change between two numbers (2 decimal places) and direction", "usage_description": "Use this when you need the percent change and whether a value moved up, down, or remained flat", "generated_by_plan_id": null, "source_artifact_ids": null, "tags": ["math", "utility"], "risk_level": "low", "validation": null, "created_at": "2026-10-08T02:08:15.474407Z", "updated_at": "2026-10-08T02:08:15.474407Z", "metadata": {"runtime_profile": "transform_only", "certification": "strict"}}, "validation": {"valid": true, "risk_level": null, "checks": [{"name": "strict_type_check", "status": "passed", "message": null}, {"name": "forbidden_tokens", "status": "passed", "message": null}, {"name": "size_limit", "status": "passed", "message": null}, {"name": "run_function", "status": "passed", "message": null}], "warnings": [], "errors": []}, "reused": false, "source_artifact_id": null}}
