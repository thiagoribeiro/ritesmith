renheit.", "status": "completed", "artifact_id": "art_01M4DSWZXK3D978XSW3SYNH6J4", "capability_id": null, "details": {"reused": false, "generated": true}}, {"step_id": "step_2", "title": "Generate trama_workflow: convert_celsius_to_fahrenheit_workflow", "description": "Workflow that calls the convert_celsius_to_fahrenheit script with the incoming payload and sends the Fahrenheit result to Telegram.", "status": "completed", "artifact_id": "art_01M4DSWZYD993805ZTW469QBKQ", "capability_id": null, "details": {"reused": false, "generated": true}}], "artifacts": [{"artifact_id": "art_01M4DSWZXK3D978XSW3SYNH6J4", "artifact_type": "luau_script", "name": "convert_celsius_to_fahrenheit", "version": 1, "status": "draft", "content": "type Context = { [string]: any }\n\ntype Input = { celsius: number }\ntype Output = { fahrenheit: number }\n\nfunction run(input: Input, context: Context): Output\n    local c: number = input.celsius\n    -- Fahrenheit = Celsius * 9/5 + 32\n    local f: number = c * 9 / 5 + 32\n    return { fahrenheit = f }\nend\n", "content_hash": "d6893a9535b2e69e43adf5e1f04d735856891b2941bc1f5e0e875fabb84a9d5b", "description": "Converts a temperature from Celsius to Fahrenheit.", "usage_description": null, "generated_by_plan_id": "plan_01M4DSWKFCV7T2B8P6Z0M8AC1V", "source_artifact_ids": null, "tags": ["temperature", "conversion"], "risk_level": "low", "validation": null, "created_at": "2026-10-08T13:05:34.651543Z", "updated_at": "2026-10-08T13:05:34.651543Z", "metadata": {"certification": "strict", "runtime_profile": "trusted_internal"}}, {"artifact_id": "art_01M4DSWZYD993805ZTW469QBKQ", "artifact_type": "trama_workflow", "name": "convert_celsius_to_fahrenheit_workflow", "version": 1, "status": "draft", "content": "{\"name\": \"convert_celsius_to_fahrenheit_workflow\", \"version\": \"2.0.0\", \"entrypoint\": \"invoke\", \"nodes\": [{\"id\": \"invoke\", \"kind\": \"task\", \"next\": \"notify\", \"action\": {\"mode\": \"sync\", \"request\": {\"url\": \"http://rite