# RiteSmith — configuration template
# Copy to .env and adjust values

# ── HTTP ──────────────────────────────────────────────────────────────────────
RITESMITH_HTTP_HOST=0.0.0.0
RITESMITH_HTTP_PORT=8081

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
RITESMITH_DATABASE_URL=postgresql+asyncpg://nanochat:nanochat@localhost:5432/ritesmith

# ── LLM ──────────────────────────────────────────────────────────────────────
RITESMITH_LLM_PROVIDER=openai
# MODEL: hard generation (workflow/lua, repairs). MODEL_FAST: classification and
# short reviews (analyze_intent, llm.evaluate) — keep it non-reasoning.
RITESMITH_LLM_MODEL=gpt-5-mini
RITESMITH_LLM_MODEL_FAST=gpt-4.1-nano
# Independently choose primary models for each generation operation.
# RITESMITH_LLM_SCRIPT_MODEL=gpt-5-mini
# RITESMITH_LLM_WORKFLOW_MODEL=gpt-5.4-mini
RITESMITH_LLM_REASONING_EFFORT=low
# Per-operation overrides inherit LLM_REASONING_EFFORT when unset.
# RITESMITH_LLM_SCRIPT_EFFORT=low
# RITESMITH_LLM_WORKFLOW_EFFORT=low
RITESMITH_LLM_FALLBACK_ENABLED=true
RITESMITH_GENERATION_SPECIALIZED_PROMPTS=true
RITESMITH_GENERATION_COMPACT_WORKFLOWS=true
# Experimental Mermaid -> typed graph -> native Trama; overrides compact output.
RITESMITH_GENERATION_MERMAID_WORKFLOWS=false
RITESMITH_GENERATION_UNIFIED_PROPOSAL=true
RITESMITH_GENERATION_PARALLEL_TESTS=true
RITESMITH_GENERATION_AVOID_SPECULATIVE_WORKFLOW_TESTS=true
RITESMITH_GENERATION_LATENCY_TARGET_SECONDS=10
RITESMITH_LLM_TIMEOUT_SECONDS=180
OPENAI_API_KEY=sk-... 

# ── Lua runtime ───────────────────────────────────────────────────────────────
RITESMITH_LUA_ENABLED=true
# Increase for network-profile scripts that make external HTTP calls
RITESMITH_LUA_TIMEOUT_MS=30000
RITESMITH_LUA_MEMORY_LIMIT_MB=32

# ── Generation ────────────────────────────────────────────────────────────────
# Number of generate→validate→repair cycles before giving up
RITESMITH_GENERATION_MAX_ATTEMPTS=2
# Days before a lua_script/trama_workflow artifact expires from FTS reuse (0 = no TTL)
RITESMITH_ARTIFACT_TTL_DAYS=30

# ── Policy ────────────────────────────────────────────────────────────────────
# Default policy when no explicit rule matches: allow | deny | require_approval
RITESMITH_POLICY_DEFAULT=deny
# Allow execution of low-risk artifacts without an explicit approval token
RITESMITH_ALLOW_UNAPPROVED_LOW_RISK=true
# Disable shell script generation entirely (strongly recommended in production)
RITESMITH_SHELL_GENERATION_ENABLED=false

# ── Workflow delegation (Trama) ───────────────────────────────────────────────
RITESMITH_WORKFLOW_DELEGATION_ENABLED=false
RITESMITH_WORKFLOW_ENGINE_URL=http://localhost:9000

# ── Observability ─────────────────────────────────────────────────────────────
RITESMITH_OTEL_ENABLED=false

# ── Reports ────────────────────────────────────────────────────────────────────
# Directory where HTML reports are stored: {REPORTS_PATH}/{YYYYMM}/{theme}/{timestamp_desc}.html
# ReportsProvider is disabled when unset.
RITESMITH_REPORTS_PATH=/home/thiago/reports

# ── Telegram (optional — report.write_html sends path notification) ────────────
RITESMITH_TELEGRAM_BOT_TOKEN=
RITESMITH_TELEGRAM_CHAT_ID=

# Independent rollback controls. New artifact formats require isolated validation first.
RITESMITH_GENERATION_TYPED_PROMPTS=true
RITESMITH_GENERATION_LUAU_ASSEMBLY=false
RITESMITH_GENERATION_SEMANTIC_WORKFLOWS=false
RITESMITH_GENERATION_BOUNDED_RECOVERY=true
RITESMITH_GENERATION_DEADLINE_SECONDS=30
RITESMITH_GENERATION_RECOVERY_MIN_SECONDS=3
RITESMITH_GENERATION_RECOVERY_ATTEMPTS=1
